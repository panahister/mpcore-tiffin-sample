{
  "realm": "tiffin",
  "displayName": "Tiffin (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Orders food"
      },
      {
        "name": "restaurant-manager",
        "description": "Keeps a restaurant's menu and accepts or refuses its orders"
      },
      {
        "name": "courier",
        "description": "Delivers"
      },
      {
        "name": "city-admin",
        "description": "Manages people, roles and restaurants of one city"
      },
      {
        "name": "platform-admin",
        "description": "Manages cities"
      },
      {
        "name": "service",
        "description": "A service of the platform, calling another"
      }
    ]
  },
  "groups": [
    {
      "name": "cities",
      "subGroups": [
        {
          "name": "tehran",
          "attributes": {
            "tenant_id": [
              "tehran"
            ]
          }
        },
        {
          "name": "istanbul",
          "attributes": {
            "tenant_id": [
              "istanbul"
            ]
          }
        },
        {
          "name": "platform",
          "attributes": {
            "tenant_id": [
              "platform"
            ]
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "tiffin-app",
      "name": "The Tiffin app (development)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tiffin-access-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tiffin-access",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tiffin-media-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tiffin-media",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tiffin-restaurants-audience",
