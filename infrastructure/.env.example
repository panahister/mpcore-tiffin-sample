# Copied to infrastructure/.env by scripts/up.sh. Development values for containers on this machine.
# Change a port here if it is taken on yours, then run scripts/setup.sh again. The ports stay clear of
# the Storefront sample's (4xxxx), so both samples can run on one machine.
COMPOSE_PROJECT_NAME=tiffin

POSTGRES_USER=tiffin
POSTGRES_PASSWORD=tiffin
POSTGRES_PORT=35432
TIMESCALE_PORT=35433

KAFKA_PORT=39092
KAFKA_UI_PORT=38080

RABBITMQ_USER=tiffin
RABBITMQ_PASSWORD=tiffin
RABBITMQ_PORT=35672
RABBITMQ_UI_PORT=35673

REDIS_PORT=36379

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=38180

WIREMOCK_PORT=38081

# The store behind the Media service: rustfs or seaweedfs. Media speaks the S3 API to either.
MEDIA_STORE=rustfs
MEDIA_S3_PORT=39000
MEDIA_S3_ACCESS_KEY=tiffin-media
MEDIA_S3_SECRET_KEY=tiffin-media-lab

# off: the edge passes every request on. keycloak: the edge verifies tokens as well.
EDGE_AUTH=off
GATEWAY_HTTPS_PORT=39443
GATEWAY_HTTP_PORT=39080

OTLP_GRPC_PORT=34317
OTLP_HTTP_PORT=34318
PROMETHEUS_PORT=39090
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=33000
JAEGER_UI_PORT=36686
