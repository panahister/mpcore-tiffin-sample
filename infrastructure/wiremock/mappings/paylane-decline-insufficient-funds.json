{
  "name": "decline-insufficient-funds",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/paylane/v1/authorizations",
    "headers": {
      "Idempotency-Key": {
        "matches": ".+"
      },
      "X-Merchant-Id": {
        "equalTo": "TIFFIN-01"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.paymentToken == 'tok_insufficient_funds')]"
      }
    ]
  },
  "response": {
    "status": 402,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "status": "DECLINED",
      "code": "INSUFFICIENT_FUNDS"
    }
  }
}