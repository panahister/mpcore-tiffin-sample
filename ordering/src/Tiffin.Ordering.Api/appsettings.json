{
  "Kestrel": {
    "Endpoints": {
      "Rest": { "Url": "http://0.0.0.0:8080", "Protocols": "Http1AndHttp2" },
      "Grpc": { "Url": "http://0.0.0.0:8081", "Protocols": "Http2" }
    }
  },
  "Transport": {
    "RestPort": 8080,
    "GrpcPort": 8081,
    "EnforcePortSeparation": true,
    // Description surfaces. Absent means Development only; set true or false to override.
    "EnableGrpcReflection": null
    ,
    "EnableOpenApi": null
  },
  "Ordering": {
    // How long a restaurant has to accept or refuse a paid order; then it is cancelled and paid back (T-08).
    "RestaurantAnswerDeadline": "00:10:00"
  },
  "Security": {
    "Authority": "http://localhost:38180/realms/tiffin",
    "Audiences": [ "tiffin-ordering" ],
    "RequireHttpsMetadata": true,
    "AllowAnonymousHealthEndpoints": true,
    "ClaimMapping": { "Preset": "Keycloak" },
    "TenantClaim": "tenant_id"
  },
  "Gateway": {
    // Proxies whose X-Forwarded-* headers are trusted, as addresses or CIDR networks. Empty = none.
    "TrustedProxies": []
  },
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=tiffin_ordering;Username=replace-me;Password=replace-me"
  },
  "Messaging": {
    "AutoProvision": false,
    "Kafka": { "BootstrapServers": "localhost:9092" },
    "RabbitMq": { "ConnectionString": "amqp://replace-me:replace-me@localhost:5672" }
  },
  "Observability": {
    "Logs": { "Exporter": "None", "Endpoint": null, "Protocol": "Grpc" },
    "Metrics": { "Exporter": "None", "Endpoint": null, "Protocol": "Grpc", "Prometheus": { "Enabled": false, "Path": "/metrics" } },
    "Traces": { "Exporter": "None", "Endpoint": null, "Protocol": "Grpc", "SamplingRatio": 1.0 },
    "Redaction": { "Enabled": true, "AdditionalSensitiveFields": [] }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
