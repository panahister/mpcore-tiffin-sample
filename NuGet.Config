<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for every backend in this repository: nuget.org, and nothing else.

    * MPCoreSource=Local (see Directory.Build.targets) builds MP Core from source, so no MPCore.*
      package is restored at all;
    * MPCoreSource=NuGet restores MPCore.* from nuget.org.

  No credential is ever needed or stored here.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
